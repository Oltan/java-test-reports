# fastapi-server/.env.example
#
# Copy this file to fastapi-server/.env and fill in real values:
#   cp .env.example .env
#
# .env is loaded by python-dotenv (see server.py: load_dotenv()) and is
# git-ignored — never commit real secrets.
#
# For Jira / SMTP / DOORS / Allure-CLI integration variables, see the
# repo-root .env.example and docs/ENTEGRASYON.md. This file only covers the
# variables read directly by fastapi-server (auth, run management, storage).

# ---------------------------------------------------------------------------
# Runtime environment
# ---------------------------------------------------------------------------

# ENV: "production" enables the startup guard that refuses to boot if
# JWT_SECRET is still the insecure default. Any other value (or unset) is
# treated as development.
ENV=development

# ---------------------------------------------------------------------------
# Authentication (server.py: JWT_SECRET/JWT_ALGORITHM/create_token/verify_token)
# ---------------------------------------------------------------------------

# JWT_SECRET: signing key for auth tokens (login tokens AND service tokens
# minted via /api/admin/service-tokens). REQUIRED in production — the server
# refuses to start with the default value when ENV=production.
# Generate one with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-me

# JWT_EXPIRATION_HOURS: how long a normal login token stays valid.
JWT_EXPIRATION_HOURS=24

# ADMIN_USERNAME / ADMIN_PASSWORD: seed credentials for the built-in admin
# account. Used as a login fallback when the DuckDB `users` table has no
# matching row (the users table itself is populated via
# POST /api/admin/users, not seeded automatically from these vars).
# Change both before exposing the server beyond localhost.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-prod

# SERVICE_TOKEN_DAYS: default validity (in days) for long-lived tokens minted
# via POST /api/admin/service-tokens when the request omits "days". These
# tokens are meant for AI-agent/automation clients (role "agent") and are
# stateless JWTs — see docs/API.md §2.4.
SERVICE_TOKEN_DAYS=365

# ---------------------------------------------------------------------------
# Test run management / queue (server.py)
# ---------------------------------------------------------------------------

# TEST_MAX_CONCURRENCY: number of jobs allowed to run their Maven steps at
# once. Additional jobs sit in 'queued' status until a slot frees up.
# Keep at 1 unless you have validated concurrent `mvn` runs on this host.
TEST_MAX_CONCURRENCY=1

# RUN_HARD_TIMEOUT: abort a run after this many seconds of total wall-clock
# time, regardless of output activity. 0 disables the hard-timeout watchdog.
RUN_HARD_TIMEOUT=3600

# RUN_STALL_TIMEOUT: abort a run after this many seconds with no test output
# (stall detection). 0 disables the stall watchdog.
RUN_STALL_TIMEOUT=900

# RUN_RECOVERY_ON_STARTUP: on process startup, mark any run left 'running'/
# 'queued' by a previous (crashed/killed) process as 'interrupted', and
# best-effort SIGTERM any surviving process group. Set to 0 to disable.
RUN_RECOVERY_ON_STARTUP=1

# JAVA_PROJECT_ROOT: Maven parent pom.xml directory. Defaults to the repo
# root (one level above fastapi-server/) if unset.
JAVA_PROJECT_ROOT=..

# MAVEN_MODULE: -pl argument passed to Maven (the Java test module).
MAVEN_MODULE=test-core

# MAVEN_CMD: full path to the mvn executable. Leave unset to use `mvn` (or
# `mvn.cmd`) from PATH.
# MAVEN_CMD=/usr/local/bin/mvn

# ALLURE_RESULTS_DIR: fallback Allure results directory used when a run's
# per-worker output_dir is not available (e.g. legacy/manual ingestion).
# Normally per-run results live under
# <JAVA_PROJECT_ROOT>/<MAVEN_MODULE>/target/allure-results-{run_id}.
# ALLURE_RESULTS_DIR=

# ---------------------------------------------------------------------------
# Storage / paths
# ---------------------------------------------------------------------------

# REPORTS_DUCKDB_PATH: path to the DuckDB database file (runs, jobs,
# worker_runs, users, scenario_results, ...). Relative paths are resolved
# against the process's current working directory (normally fastapi-server/),
# so prefer an absolute path in production.
REPORTS_DUCKDB_PATH=reports.duckdb

# MANIFESTS_DIR: directory where per-run manifest JSON files are written
# and read from. Defaults to <repo_root>/manifests if unset.
MANIFESTS_DIR=../manifests
